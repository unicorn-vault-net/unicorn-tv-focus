+
+package android.view.focus;
+
+import android.accessibilityservice.AccessibilityServiceInfo;
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.content.ComponentName;
+import android.content.pm.ResolveInfo;
+import android.content.pm.ServiceInfo;
+import android.os.SystemProperties;
+import android.util.Log;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStreamReader;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Framework-side package filter for the D-pad focus overlay.
+ *
+ * <p>Reads a plain-text file listing package names that should receive the focus policy.
+ * One package name per line; lines starting with '#' are comments; empty lines are skipped.
+ *
+ * <p>Default path: {@code /system/etc/tvfocus-packages.txt}
+ * Override at runtime:
+ * {@code adb shell setprop persist.sys.dpad_focus.packages /sdcard/test-packages.txt}
+ *
+ * <p>If the file doesn't exist or is empty, returns {@code true} for all packages (backward
+ * compatibility -- the policy attaches to every window). The filter is loaded once per process
+ * (lazy on first call) and cached; changes require a process restart.
+ *
+ * <p>Called by {@code ViewRootImpl.maybeLoadFocusPolicy()} BEFORE the policy class is
+ * instantiated -- non-listed apps get zero overhead (no instance, no attach, no layout
+ * callbacks).
+ */
+public final class PackageFilter {
+
+    private static final String TAG = "PackageFilter";
+    private static final String PACKAGES_PROP = "persist.sys.dpad_focus.packages";
+    private static final String PACKAGES_DEFAULT_PATH = "/system/etc/tvfocus-packages.txt";
+
+    private static volatile Set<String> sAllowedPackages;  // null = not loaded yet
+    private static final Object sLock = new Object();
+
+    private PackageFilter() {}
+
+    /**
+     * Check whether the focus policy should be loaded for the given package.
+     *
+     * @param packageName the package name of the app owning this window
+     * @return {@code true} if the policy should be attached for this package
+     */
+    public static boolean shouldAttach(@Nullable String packageName) {
+        if (packageName == null || packageName.isEmpty()) return true;
+        Set<String> allowed = sAllowedPackages;
+        if (allowed != null) {
+            // Fast path: already loaded. Empty set = attach to all (backward compat).
+            return allowed.isEmpty() || allowed.contains(packageName);
+        }
+        // Lazy load (synchronized to avoid double-read on concurrent first calls).
+        synchronized (sLock) {
+            if (sAllowedPackages != null) {
+                return sAllowedPackages.isEmpty() || sAllowedPackages.contains(packageName);
+            }
+            sAllowedPackages = loadPackageFilter();
+            Log.i(TAG, "Package filter loaded: " + sAllowedPackages.size() + " packages");
+            return sAllowedPackages.isEmpty() || sAllowedPackages.contains(packageName);
+        }
+    }
+
+    // ---- forced accessibility (Compose semantics enumeration) ---------------------------
+
+    /** Master on/off -- read once per process; a runtime setprop takes effect
+     *  only after the process restarts. */
+    private static volatile int sEnabledCached = -1;  // -1 = unread
+    /** a11y property, read once -- provider creation is attach-scoped anyway. */
+    private static volatile int sA11yPropCached = -1;  // -1 = unread
+
+    /**
+     * Whether this process should see forced accessibility so Compose builds its
+     * semantics tree for the D-pad focus overlay. Requires the master switch
+     * ({@code persist.sys.dpad_focus.enabled}), the a11y property
+     * ({@code persist.sys.dpad_focus.a11y}), and this package in the whitelist.
+     * Apps outside the filter see real accessibility state and pay zero cost.
+     *
+     * @param packageName package of the calling process (ActivityThread.currentPackageName())
+     */
+    public static boolean isA11yForced(@Nullable String packageName) {
+        int e = sEnabledCached;
+        if (e < 0) {
+            e = SystemProperties.getBoolean("persist.sys.dpad_focus.enabled", true) ? 1 : 0;
+            sEnabledCached = e;
+        }
+        if (e == 0) {
+            return false;
+        }
+        int p = sA11yPropCached;
+        if (p < 0) {
+            p = SystemProperties.getBoolean("persist.sys.dpad_focus.a11y", false) ? 1 : 0;
+            sA11yPropCached = p;
+        }
+        return p == 1 && shouldAttach(packageName);
+    }
+
+    private static volatile List<AccessibilityServiceInfo> sDummyA11yServices;
+
+    /**
+     * A dummy non-empty enabled-service list for the AccessibilityManager patch.
+     * Compose's delegate requires {@code enabledServices.isNotEmpty()} in addition to
+     * {@code isEnabled()}. Built once per process; the @hide members
+     * ({@code setComponentName}, {@code mResolveInfo}) are set reflectively so this file
+     * still compiles against the public SDK jar on the host.
+     */
+    @NonNull
+    public static List<AccessibilityServiceInfo> dummyA11yServiceList() {
+        List<AccessibilityServiceInfo> cached = sDummyA11yServices;
+        if (cached != null) {
+            return cached;
+        }
+        final List<AccessibilityServiceInfo> dummy = new ArrayList<>(1);
+        final AccessibilityServiceInfo info = new AccessibilityServiceInfo();
+        try {
+            final String pkg = "com.unicorn.dpadfocus";
+            final String cls = "com.unicorn.dpadfocus.DummyService";
+            final Method setComponentName = AccessibilityServiceInfo.class
+                    .getDeclaredMethod("setComponentName", ComponentName.class);
+            setComponentName.setAccessible(true);
+            setComponentName.invoke(info, new ComponentName(pkg, cls));
+            final Field f = AccessibilityServiceInfo.class.getDeclaredField("mResolveInfo");
+            f.setAccessible(true);
+            final ResolveInfo ri = new ResolveInfo();
+            ri.serviceInfo = new ServiceInfo();
+            ri.serviceInfo.packageName = pkg;
+            ri.serviceInfo.name = cls;
+            f.set(info, ri);
+        } catch (Throwable t) {
+            Log.w(TAG, "Unicorn: failed to build dummy service info", t);
+        }
+        dummy.add(info);
+        cached = Collections.unmodifiableList(dummy);
+        sDummyA11yServices = cached;
+        return cached;
+    }
+
+    private static Set<String> loadPackageFilter() {
+        Set<String> packages = new HashSet<>();
+        try {
+            String path = SystemProperties.get(PACKAGES_PROP, PACKAGES_DEFAULT_PATH);
+            File f = new File(path);
+            if (!f.exists() || !f.canRead()) return packages;
+            BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(new FileInputStream(f), "UTF-8"));
+            try {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    line = line.trim();
+                    if (line.isEmpty() || line.startsWith("#")) continue;
+                    packages.add(line);
+                }
+            } finally {
+                reader.close();
+            }
+        } catch (Throwable t) {
+            Log.w(TAG, "Package filter load failed: " + t);
+        }
+        return packages;
+    }
+}
