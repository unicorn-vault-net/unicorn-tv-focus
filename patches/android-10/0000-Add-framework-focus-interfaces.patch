+package android.view.focus;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+import android.view.KeyEvent;
+import java.util.List;
+
+/**
+ * Thin framework-side contract for the system-wide D-pad focus overlay.
+ *
+ * <p>The framework ({@code ViewRootImpl}) knows nothing about the focus algorithm. It only:
+ * <ul>
+ *   <li>hands the policy each candidate D-pad / select key ({@link #onKeyEvent}),</li>
+ *   <li>asks the policy for the rectangle to draw ({@link #getFocusRect}),</li>
+ *   <li>tells the policy the node set may have changed ({@link #onLayoutDirty}).</li>
+ * </ul>
+ *
+ * <p>All methods run on the app's UI thread. The implementation is loaded from a
+ * bootclasspath jar (see {@code persist.sys.dpad_focus.policy}); it never runs in
+ * {@code system_server} and holds no system privileges. Anything global (cross-window cursor,
+ * enable state, per-package profile) is brokered through the implementation's own binder
+ * connection to the coordinator service, not through this interface.
+ *
+ * <p>The implementation must be cheap: {@link #onKeyEvent} is on the input hot path and
+ * {@link #getFocusRect} is called once per draw.
+ */
+public interface IFocusPolicy {
+
+    /**
+     * Called once, right after the policy is attached to a window.
+     *
+     * @param host facade the policy uses to read the window and request redraws / input.
+     */
+    void attach(@NonNull FocusHost host);
+
+    /**
+     * Offer a key event to the policy.
+     *
+     * <p>Invoked from {@code ViewPostImeInputStage.processKeyEvent} <em>after</em> the app's own
+     * {@code mView.dispatchKeyEvent} has declined the event, in place of the framework's
+     * {@code performFocusNavigation}. Returning {@code true} consumes the event (the framework
+     * treats it as {@code FINISH_HANDLED}); returning {@code false} lets the framework fall
+     * through to its default navigation.
+     *
+     * @param event the key event (already declined by the app).
+     * @return {@code true} if the policy handled it.
+     */
+    boolean onKeyEvent(@NonNull KeyEvent event);
+
+    /**
+     * Fill {@code outWindowRect} with the highlight rectangle in <em>window</em> coordinates.
+     *
+     * <p>Called from the draw path. Return {@code false} to draw nothing this frame.
+     *
+     * @param outWindowRect output; window-relative rect to highlight.
+     * @return {@code true} if a rect should be drawn.
+     */
+    boolean getFocusRect(@NonNull Rect outWindowRect);
+
+    /**
+     * Alpha for the highlight drawable, 0-255. The policy dims the rect while a
+     * directional action is in flight (scroll issued but not yet settled) or
+     * while the tracked focus is unconfirmed (gone verdict pending) -- a
+     * "traveling" cue instead of a full-strength ring on a stale position.
+     *
+     * <p>Called from the draw path, after {@link #getFocusRect}. Must be cheap:
+     * derived from policy state, no computation.
+     *
+     * @return drawable alpha, 255 = fully opaque.
+     */
+    int getFocusRectAlpha();
+
+    /**
+     * Optional policy-owned highlight drawable. When non-null the framework draws it instead
+     * of the theme's {@code accessibilityFocusedDrawable}; the policy's drawable is still
+     * alpha-modulated by {@link #getFocusRectAlpha} and clipped by {@link #getOccludingRects}.
+     *
+     * <p>Called once per draw after {@link #getFocusRect}. Must be cheap: return a cached
+     * instance. A {@code default} method so a new framework against an old policy jar (which
+     * lacks the override) falls back to the theme drawable instead of crashing.
+     *
+     * @return the drawable to draw at the focus rect, or {@code null} for the theme default.
+     */
+    @Nullable
+    default Drawable getFocusDrawable() {
+        return null;
+    }
+
+    /**
+     * Append window-coordinate rects of floating action zones that visually occlude the content
+     * below them. The framework clips the focus rect against these so it doesn't draw on top of
+     * a floating bar that should be above the focused view in z-order.
+     *
+     * <p>Called from the draw path, after {@link #getFocusRect}. Must be cheap (read a cache;
+     * the expensive analysis runs only on key press). Append nothing if there are no occluding
+     * zones.
+     *
+     * @param outRects output; append window-relative occluding rects to this list.
+     */
+    void getOccludingRects(@NonNull List<Rect> outRects);
+
+    /**
+     * Signal that the view/semantics tree may have changed (layout, traversal, resize).
+     *
+     * <p>Must be O(1): set a dirty flag only. Actual (re)collection happens lazily on the next
+     * {@link #onKeyEvent}. Called from {@code performTraversals} and {@code handleResized}, which
+     * run on every animation frame -- doing real work here would blow the frame budget.
+     */
+    void onLayoutDirty();
+
+    /** Called when the window is going away; release references and the coordinator connection. */
+    void detach();
+}
diff --git a/frameworks/base/core/java/android/view/focus/PackageFilter.java b/frameworks/base/core/java/android/view/focus/PackageFilter.java
new file mode 100644
index 0000000..5b0fcbad0096eb15b3edd65e97ec3558cdc83f5a
--- /dev/null
+++ b/frameworks/base/core/java/android/view/focus/PackageFilter.java
@@ -0,0 +1,183 @@
+/*
