+package android.view.focus;
+
+import android.annotation.NonNull;
+import android.graphics.Rect;
+import android.view.InputEvent;
+import android.view.View;
+
+/**
+ * Facade the framework passes to an {@link IFocusPolicy}, exposing exactly the pieces of
+ * {@code ViewRootImpl} the policy needs and nothing else.
+ *
+ * <p>Implemented by {@code ViewRootImpl} (or a small inner adapter). Keeping this narrow is what
+ * lets the policy live in a replaceable jar while the framework surface stays frozen.
+ */
+public interface FocusHost {
+
+    /** @return the window's root view; the entry point for the legacy-View walk. */
+    @NonNull View getRootView();
+
+    /** Fill {@code out} with the window frame in screen coordinates. */
+    void getWindowFrame(@NonNull Rect out);
+
+    /** Logical display id this window is on (for per-display cursor scoping). */
+    int getDisplayId();
+
+    /** Package name of the app owning this window (for per-package profile selection). */
+    @NonNull String getPackageName();
+
+    /** Density (dpi / 160) for resolving dp / percent units against this window. */
+    float getDensity();
+
+    /** Request a redraw so a new {@link IFocusPolicy#getFocusRect} result is picked up. */
+    void invalidate();
+
+    /**
+     * Feed a synthesized event back into this window's own input pipeline.
+     *
+     * <p>Same-window, no {@code INJECT_EVENTS} permission required. Used only as the activation
+     * fallback; realistic tap/swipe/fling go through the native {@code uinputd} instead.
+     */
+    void enqueueInputEvent(@NonNull InputEvent event);
+}
