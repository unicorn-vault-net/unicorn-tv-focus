+    private void maybeLoadFocusPolicy() {
+        if (mFocusPolicy != null || !isFocusPolicyEnabled()) {
+            return;
+        }
+        final String impl = SystemProperties.get(FOCUS_POLICY_PROP, "");
+        if (impl.isEmpty()) {
+            return;
